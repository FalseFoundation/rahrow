{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "RahRow Desktop",
	"version": "0.0.0",
	"identifier": "foundation.false.rahrow.desktop",
	"build": {
		"beforeDevCommand": "pnpm dev:web",
		"beforeBuildCommand": "pnpm build:web",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "RahRow Desktop",
				"width": 1200,
				"height": 800,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": false
		}
}
