{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "RahRow",
	"version": "0.0.0",
	"identifier": "foundation.false.rahrow.desktop",
	"build": {
		"beforeDevCommand": "pnpm dev:web",
		"beforeBuildCommand": "pnpm build:web && pnpm stage:engine-sidecars && pnpm validate:engine-configs",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "RahRow",
				"width": 393,
				"height": 800,
				"minWidth": 393,
				"maxWidth": 393,
				"minHeight": 640,
				"backgroundColor": "#171717",
				"theme": "Dark",
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/256x256.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
