{
	"name": "@rahrow/desktop",
	"private": true,
	"version": "0.0.0",
	"description": "RahRow application",
	"type": "module",
	"scripts": {
		"watch": "tsc --watch --preserveWatchOutput",
		"dev:web": "vite --host 127.0.0.1 --port 1420",
		"build:web": "vite build",
		"dev": "node --experimental-strip-types ./scripts/dev-with-engines.ts",
		"build": "vite build",
		"icons:generate": "tauri icon ../../packages/static/src/images/rahrow-logo-white-filled.svg",
		"bundle": "tauri build --config src-tauri/tauri.sidecar.json",
		"bundle:verify": "node --experimental-strip-types ./scripts/verify-installed-bundle.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"stage:engine-sidecars": "node --experimental-strip-types ./scripts/stage-engine-sidecars.ts",
		"validate:engine-configs": "node ./scripts/validate-engine-configs.mjs",
		"validate:vpn-release": "node --experimental-strip-types ./scripts/validate-vpn-release.ts",
		"cleanup": "rm -rf dist .turbo node_modules"
	},
	"dependencies": {
		"@rahrow/ads": "workspace:*",
		"@rahrow/core": "workspace:*",
		"@rahrow/engine": "workspace:*",
		"@rahrow/features": "workspace:*",
		"@rahrow/tooling": "workspace:*",
		"@rahrow/ui": "workspace:*",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"esbuild": "^0.28.2",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
