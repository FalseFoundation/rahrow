{
	"name": "@rahrow/mobile",
	"private": true,
	"version": "0.0.0",
	"description": "RahRow application",
	"type": "module",
	"scripts": {
		"watch": "tsc --watch --preserveWatchOutput",
		"dev": "vite --port 1421",
		"build": "vite build",
		"icons:generate": "capacitor-assets generate --assetPath assets --ios --android --iconBackgroundColor '#000000' --iconBackgroundColorDark '#000000' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#000000'",
		"capacitor:build": "capacitor build",
		"capacitor:run": "capacitor run",
		"capacitor:sync": "capacitor sync",
		"capacitor:start": "capacitor start",
		"native:verify-pins": "node scripts/verify-native-runtimes.mjs --pins-only",
		"native:verify": "node scripts/verify-native-runtimes.mjs",
		"native:build": "node scripts/build-native-runtimes.mjs",
		"native:build:android": "node scripts/build-native-runtimes.mjs android",
		"native:build:apple": "node scripts/build-native-runtimes.mjs apple",
		"native:build:hev:android": "node scripts/build-hev-tunnel.mjs android",
		"native:build:hev:apple": "node scripts/build-hev-tunnel.mjs apple",
		"android:preview:check": "node scripts/android-development-preview.mjs check-project",
		"android:preview:stage-runtimes": "node scripts/android-development-preview.mjs stage-runtimes",
		"android:preview:build": "node scripts/android-development-preview.mjs build-debug",
		"android:preview:verify": "node scripts/android-development-preview.mjs verify-apk",
		"ios:preview:check": "node scripts/ios-development-preview.mjs check-project",
		"ios:preview:stage-runtimes": "node scripts/ios-development-preview.mjs stage-runtimes",
		"ios:preview:simulator": "node scripts/ios-development-preview.mjs build-simulator",
		"ios:preview:device": "node scripts/ios-development-preview.mjs build-device",
		"ios:preview:install": "node scripts/ios-development-preview.mjs install-device",
		"ios:preview:verify": "node scripts/ios-development-preview.mjs verify-bundle",
		"bundle:android": "node scripts/android-development-preview.mjs build-debug",
		"bundle:ios": "node scripts/ios-development-preview.mjs build-device",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"cleanup": "rm -rf dist .turbo node_modules"
	},
	"dependencies": {
		"@capacitor-community/admob": "8.1.0",
		"@capacitor/android": "^8.5.2",
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.5.2",
		"@capacitor/ios": "^8.5.2",
		"@capacitor/preferences": "^8.0.1",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@rahrow/ads": "workspace:*",
		"@rahrow/core": "workspace:*",
		"@rahrow/engine": "workspace:*",
		"@rahrow/features": "workspace:*",
		"@rahrow/tooling": "workspace:*",
		"@rahrow/ui": "workspace:*",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.5.2",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "^0.28.2",
		"postcss": "^8.5.28",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	}
}
