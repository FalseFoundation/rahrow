{
	"name": "@rahrow/cli",
	"private": true,
	"version": "0.0.0",
	"description": "RahRow command line interface.",
	"type": "module",
	"bin": {
		"rahrow": "./src/bin.ts"
	},
	"scripts": {
		"watch": "tsc --watch --preserveWatchOutput",
