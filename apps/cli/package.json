	},
	"dependencies": {
		"@rahrow/core": "workspace:*",
		"@rahrow/engine": "workspace:*"
	},
	"devDependencies": {
		"@rahrow/tooling": "workspace:*",
		"@types/node": "^26.2.0",
		"vitest": "^4.1.11"
	},
	"files": [
		"src",
		"README.md"
	]
}
