{
	"id": "vless:example.com:443",
	"protocol": "vless",
	"endpoint": {
		"host": "example.com",
		"port": 443
	},
	"transport": {
		"type": "httpupgrade",
		"host": "cdn.example.com",
		"path": "/upgrade",
		"mux": true,
		"packetEncoding": "xudp"
	},
	"security": {
		"type": "tls",
		"serverName": "edge.example.com",
		"alpn": ["h2", "http/1.1"],
		"allowInsecure": true
	},
	"authentication": {
		"id": "11111111-1111-4111-8111-111111111111",
		"encryption": "none"
	},
	"metadata": {
		"name": "Upgrade",
		"source": "url"
	}
}
