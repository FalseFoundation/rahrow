{
	"name": "@rahrow/features",
	"private": true,
	"version": "0.0.0",
	"description": "Shared app-facing React feature behavior for RahRow clients.",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./*": "./src/*"
	},
	"scripts": {
		"watch": "tsc --watch --preserveWatchOutput",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"cleanup": "rm -rf dist .turbo node_modules"
	},
	"dependencies": {
		"@rahrow/ads": "workspace:*",
		"@rahrow/core": "workspace:*",
		"@rahrow/static": "workspace:*",
		"@rahrow/ui": "workspace:*",
		"@tanstack/pacer": "^0.23.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-pacer": "^0.24.0",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-store": "^0.11.2",
		"@tanstack/react-virtual": "^3.14.13",
		"@tanstack/store": "^0.11.2",
		"i18next": "^26.4.2",
		"qrcode": "^1.5.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-i18next": "^17.0.15",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@rahrow/tooling": "workspace:*",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"files": [
		"src"
	]
}
