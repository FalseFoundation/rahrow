{
	"name": "rahrow",
	"author": {
		"name": "junkieshuffle",
		"url": "https://github.com/junkieshuffle"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FalseFoundation/rahrow.git"
	},
	"homepage": "https://rahrow.false.foundation/",
	"bugs": {
		"url": "https://github.com/FalseFoundation/rahrow/issues"
	},
	"private": true,
	"version": "0.0.0",
	"description": "RahRow monorepo root",
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"test": "turbo test && vitest run --passWithNoTests",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "pnpm lint && pnpm test && pnpm build",
		"clean": "turbo clean",
		"update-deps": "pnpm up --latest --recursive && pnpm dedupe && pnpm audit --fix update"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@changesets/cli": "^2.31.0",
		"@rahrow/tooling": "workspace:*",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"turbo": "2.9.18",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=24.16.0",
		"pnpm": ">=11.2.2"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,jsonc,css,mdx}": [
			"biome check --write --no-errors-on-unmatched",
			"biome format --write --no-errors-on-unmatched"
		]
	}
}
