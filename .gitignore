package-lock.json
yarn.lock
pnpm-debug.log*

# testing
/coverage
/.artifacts

# next.js
/.next/
/out/

# production
**/build
**/target

# misc
**/.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
# **/.env
**/.env.*
!**/.env.example

# vercel
**/.vercel

# typescript
**/*.tsbuildinfo
**/next-env.d.ts

